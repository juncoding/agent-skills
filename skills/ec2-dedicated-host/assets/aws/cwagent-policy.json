{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "AgentMetrics", "Effect": "Allow", "Action": "cloudwatch:PutMetricData", "Resource": "*",
      "Condition": { "StringEquals": { "cloudwatch:namespace": "CWAgent" } } },
    { "Sid": "AgentDescribe", "Effect": "Allow", "Action": ["ec2:DescribeTags", "ec2:DescribeVolumes"], "Resource": "*" }
  ]
}
